/* wifi_secret.h.example - Wi-Fi の SSID とパスワードのひな形(ダミーの値)。コミットされるのはこのファイルだけ。
 *
 * 使い方:
 *   1. このファイルを同じフォルダに wifi_secret.h という名前でコピーする。
 *   2. WIFI_SSID と WIFI_PASS を、自分の 2.4GHz の AP(WPA2-PSK)の値に書き換える。
 *   3. wifi_secret.h は .gitignore 済み(コミットされない)。git status に出ていないことを毎回確認する。
 *
 * 書き方: C の文字列。" と \ を含む場合は \" と \\ と書く。AT コマンドの , " \ のエスケープはソフトが付ける。
 * 注意: 値は ELF・MOT・map に平文で入る。それらを他人に渡さない。ログ・記事・チャットに貼らない。 */
#ifndef WIFI_SECRET_H
#define WIFI_SECRET_H

#define WIFI_SSID   "EXAMPLE_SSID"
#define WIFI_PASS   "EXAMPLE_PASSWORD"

#endif /* WIFI_SECRET_H */
