# monitor 隠しコマンドの応答探索(MI, non-stop, load なし)。各コマンドの応答(OK / Protocol error / 出力)だけを見る。走らせない
# 前提: サーバー起動済み。書込みなし。終了状態: 停止中のまま
-gdb-set non-stop on
-gdb-set mi-async on
-target-select remote localhost:$PORT
#sleep 2
-interpreter-exec console "monitor console_log_enable"
-interpreter-exec console "monitor ignore_continue_during_connect"
-interpreter-exec console "echo ---- ignore_continue_during_connect\n"
-interpreter-exec console "monitor ignore_continue_during_connect,0"
-interpreter-exec console "echo ---- ignore_continue_during_connect,0\n"
-interpreter-exec console "monitor ignore_continue_during_connect,1"
-interpreter-exec console "echo ---- ignore_continue_during_connect,1\n"
-interpreter-exec console "monitor enable_execute_on_connect"
-interpreter-exec console "echo ---- enable_execute_on_connect\n"
-interpreter-exec console "monitor enable_execute_on_connect,0"
-interpreter-exec console "echo ---- enable_execute_on_connect,0\n"
-interpreter-exec console "monitor enable_execute_on_connect,1"
-interpreter-exec console "echo ---- enable_execute_on_connect,1\n"
-interpreter-exec console "monitor skip_continue"
-interpreter-exec console "echo ---- skip_continue\n"
-interpreter-exec console "monitor skip_continue,0"
-interpreter-exec console "echo ---- skip_continue,0\n"
-interpreter-exec console "monitor skip_step,0"
-interpreter-exec console "echo ---- skip_step,0\n"
-interpreter-exec console "monitor start_resume"
-interpreter-exec console "echo ---- start_resume\n"
-interpreter-exec console "monitor stop_resume"
-interpreter-exec console "echo ---- stop_resume\n"
-interpreter-exec console "monitor finish_resume"
-interpreter-exec console "echo ---- finish_resume\n"
-interpreter-exec console "monitor go_all,0"
-interpreter-exec console "echo ---- go_all,0\n"
-interpreter-exec console "monitor can_go_all"
-interpreter-exec console "echo ---- can_go_all\n"
-interpreter-exec console "monitor refresh_all"
-interpreter-exec console "echo ---- refresh_all\n"
-interpreter-exec console "monitor printSettings"
-interpreter-exec console "echo ---- printSettings\n"
-interpreter-exec console "monitor resume,0"
-interpreter-exec console "echo ---- resume,0\n"
-interpreter-exec console "monitor notify_resumed,0"
-interpreter-exec console "echo ---- notify_resumed,0\n"
-interpreter-exec console "monitor prg_download_start_on_connect,0"
-interpreter-exec console "echo ---- prg_download_start_on_connect,0\n"
-interpreter-exec console "monitor enable_synced_core_stopped_notify"
-interpreter-exec console "echo ---- enable_synced_core_stopped_notify\n"
-interpreter-exec console "monitor do_nothing"
-interpreter-exec console "echo ---- do_nothing\n"
-gdb-exit
