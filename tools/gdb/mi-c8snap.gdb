# generated by jobs/c8/gen_gdb.py. CLUT8 experiment snapshots. precondition: server up, COM7 free. MCU resets on connect (stage 0 restarts).
# end state: gdb disconnect = CPU stopped (restore with rfp -sig -run)
-gdb-set non-stop on
-gdb-set mi-async on
-target-select remote localhost:$PORT
#sleep 2
-interpreter-exec console "monitor enable_stopped_notify_on_connect"
#waitout \*stopped 8
-interpreter-exec console "monitor enable_execute_on_connect"
-exec-continue --thread 1
#sleep 4
-exec-interrupt --all
#waitnew \*stopped 8
-interpreter-exec console "echo ==== STOPPED_HOLD_BEGIN\n"
#sleep 10
-interpreter-exec console "echo ==== STOPPED_HOLD_END\n"
-interpreter-exec console "echo ==== SNAP s0\n"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2FLM2"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2FLM3.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2FLM5.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2FLM6.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2FLMRD.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2AB1.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2AB2.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2AB3.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2CLUTINT.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2VEN.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->GR2BASE.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->BGEN.LONG"
-interpreter-exec console "print/x ((struct st_glcdc *)0xe0000)->STMON.LONG"
-interpreter-exec console "echo CLUT0[0..3,9,10] then CLUT1:\n"
-interpreter-exec console "x/12wx 0xe0800"
-interpreter-exec console "x/12wx 0xe0c00"
-interpreter-exec console "x/wx 0xe0808"
-interpreter-exec console "x/wx 0xe0c08"
-interpreter-exec console "x/wx 0xFE7F5D00"
-interpreter-exec console "print g_c8_mde"
-interpreter-exec console "print g_app_dbg"
-interpreter-exec console "print/x s_pal_a[0]@4"
-interpreter-exec console "set $fb = ((struct st_glcdc *)0xe0000)->GR2FLM2"
-interpreter-exec console "dump binary memory D:/workspace/rx72n/rx72n_stockview/jobs/c8/gdb/face_s0.bin $fb ($fb+139264)"
-interpreter-exec console "dump binary memory D:/workspace/rx72n/rx72n_stockview/jobs/c8/gdb/pal0_s0.bin 0xe0800 0xe0c00"
-interpreter-exec console "dump binary memory D:/workspace/rx72n/rx72n_stockview/jobs/c8/gdb/pal1_s0.bin 0xe0c00 0xe1000"
#sync d_s0 120
-exec-continue --thread 1
#sleep 2
#uart nn
#sleep 2.4
-exec-interrupt --all
#waitnew \*stopped 8
